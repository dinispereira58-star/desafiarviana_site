{
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|twitterbot|whatsapp|linkedinbot|slackbot|telegrambot|discordbot|pinterest|skypeuripreview|redditbot|vkshare|w3c_validator).*"
        }
      ],
      "destination": "/api/og?path=:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
